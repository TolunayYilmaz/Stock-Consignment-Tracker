# Supabase baglanti dizesi.
# Vercel serverless fonksiyonlari IPv6 desteklemedigi icin DIRECT baglanti (db.<ref>.supabase.co:5432) CALISMAZ.
# Transaction pooler baglantisini kullanin (Supabase Dashboard > Connect > Transaction pooler):
#   postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-region-1.pooler.supabase.com:6543/postgres

# JWT Guvenlik - ZORUNLU (Vercel'e de ekleyin)
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440